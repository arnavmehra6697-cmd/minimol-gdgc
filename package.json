{
  "name": "hivenet-desktop",
  "version": "1.0.0",
  "description": "HiveNet — Decentralized Edge Cloud Storage & Smart Router Standalone App",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"node electron/wait-and-launch.js\"",
    "start": "concurrently -k \"vite\" \"node electron/wait-and-launch.js\"",
    "dev:ui": "vite",
    "build": "vite build",
    "dist": "npm run build && electron-builder",
    "package:portable": "npm run build && electron-builder --win portable",
    "package:dir": "npm run build && electron-builder --dir"
  },
  "build": {
    "appId": "com.hivenet.desktop",
    "productName": "HiveNet",
    "icon": "build/icon.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^29.1.5",
    "electron-builder": "^26.0.12",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.6"
  }
}
